  - _kind: 0
    _speaker: 
    _portrait: robot_normal
    _text: "\u300C\u73FE\u5728\u5730\u3001\u7814\u7A76\u68DF\u63A5\u7D9A\u901A\u8DEF\u3092\u901A\u904E\u3057\u3001\u672C\u68DF3\u968E\u30A8\u30EA\u30A2\u3078\u5230\u9054\u3057\u307E\u3057\u305F\u3002
