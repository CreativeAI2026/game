    _portrait: hero_confused
    _text: "\u300C\u3055\u3063\u304D\u307E\u3067\u306E\u30B8\u30E1\u30B8\u30E1\u3057\u305F\u72ED\u3044\u5ECA\u4E0B\u3068\u306F\u5927\u9055\u3044\u3060\u306A\u3002
