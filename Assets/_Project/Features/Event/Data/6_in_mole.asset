  - _kind: 0
    _speaker: 
    _portrait: robot_normal
    _text: "\u300C\u3054\u6307\u6458\u306E\u901A\u308A\u3001\u5F53\u30A8\u30EA\u30A2\u306F\u5E83\u57DF\u306A\u5439\u304D\u629C\u3051\u304A\u3088\u3073\u30DB\u30FC\u30EB\u69CB\u9020\u3092\u6709\u3057\u3066\u3044\u307E\u3059\u3002
