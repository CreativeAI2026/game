    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_question
    _text: "\u300C\u6A2A\u306B\u30AB\u30FC\u30C9\u30EA\u30FC\u30C0\u30FC\u304C\u3042\u308B\u306A\u2026\u2026\u3002<wait=0.3>\u5C02\u7528\u306E\u30AB\u30FC\u30C9\u30AD\u30FC\u304C\u306D\u3047\u3068\u958B\u304B\u306D\u3047\u306E\u304B\uFF1F\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_normal
    _text: "\u300C\u8077\u54E1\u3068\u304B\u3044\u306D\u30FC\u306E\u304B\u3088\u3002<wait=0.5>
      \u304A\u30FC\u3044\u3001<wait=0.2>\u8AB0\u304B\u3044\u307E\u305B\u3093\u304B\u30FC\uFF1F\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: 
    _text: "\u300C\u2026\u30A1\u2026\u2026\u3001<wait=0.2>\u2026\u2026\u30B0\u3001<wait=0.2>\u30A5\u30A5\u2026\u2026\u30C3\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_question
    _text: "\u300C\u3093\uFF1F <wait=0.5> \u4ECA\u3001<wait=0.2>\u5965\u304B\u3089\u58F0\u304C\u2026\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: 
    _text: "\u5ECA\u4E0B\u306E\u66F2\u304C\u308A\u89D2\u3001<wait=0.2>\u975E\u5E38\u706F\u304C\u70B9\u6EC5\u3059\u308B\u6697\u304C\u308A\u304B\u3089\u3001<wait=0.2>\u4F55\u304B\u3092\u5F15\u304D\u305A\u308B\u3088\u3046\u306A\u91CD\u305F\u3044\u8DB3\u97F3\u304C\u8FD1\u3065\u3044\u3066\u304F\u308B\u3002"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_surprised
    _text: "\u300C\u3046\u304A\u3063\uFF01\uFF1F <wait=0.5> \u3093\u3060\u30A2\u30EC\u2026\uFF1F\uFF01\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: 
    _text: "\u300C\u2026\u2026\u30C3\uFF01\uFF01<wait=0.5> \u30A2\u2026\u2026\u30AC\u30A2\u30A1\u30A2\u30A2\u30A2\u30A2\u30A2\u30C3\uFF01\uFF01\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_surprised
    _text: "\u300C\u3046\u308F\u3042\u3042\u3042\u3063\uFF01\uFF1F <wait=0.5> \u5F85\u3066\u5F85\u3066\u3001<wait=0.2>\u8A71\u901A\u3058\u308B\u611F\u3058\u3058\u3083\u306D\u30FC\u305E\u30B3\u30EC\uFF01
