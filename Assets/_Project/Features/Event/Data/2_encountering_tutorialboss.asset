  - _kind: 0
    _speaker: 
    _portrait: hero_confused
    _text: "\u300C\u30C1\u30C3\u3001<wait=0.2>\u3053\u3063\u3061\u306E\u6249\u3082\u30ED\u30C3\u30AF\u3055\u308C\u3066\u3093\u306E\u304B\u3088\u3002\u300D "
