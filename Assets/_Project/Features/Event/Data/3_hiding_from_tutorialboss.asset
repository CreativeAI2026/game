    _weaponKey: sword
    _message: "\u300C\u30AB\u30C3\u30BF\u30FC\u306E\u5263\u300D\u3092\u624B\u306B\u5165\u308C\u305F\u3002"
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_question
    _text: "\u300C\u3093\u2026\u30AB\u30C3\u30BF\u30FC\u306E\u5263\uFF1F\uFF1F\u30DE\u30B8\u3067\u4F55\u306A\u3093\u3060\u3001\u3053\u306E\u65BD\u8A2D\u300D"
