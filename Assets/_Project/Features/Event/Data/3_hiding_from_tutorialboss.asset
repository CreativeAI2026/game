  - _kind: 0
    _speaker: 
    _portrait: 
    _text: "\u6249\u306E\u5411\u3053\u3046\u3067\u3001<wait=0.3>\u30C9\u30F3\u30C3\uFF01<wait=0.5>\u3068\u3001\u91CD\u3044\u8089\u4F53\u304C\u3076\u3064\u304B\u308B\u97F3\u304C\u97FF\u304D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: 
    _text: "\u3084\u304C\u3066\u30BA\u30EB\u30BA\u30EB\u3068\u9060\u3056\u304B\u3063\u3066\u3044\u304F\u6C17\u914D\u304C\u3059\u308B\u3002"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: 
    _text: "\u606F\u3092\u6BBA\u3057\u3066\u6C17\u914D\u3092\u63A2\u308A\u3001<wait=0.5>\u30A2\u30AA\u30A4\u306F\u6050\u308B\u6050\u308B\u30ED\u30C3\u30AB\u30FC\u3092\u51FA\u305F\u3002"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_confused
    _text: "\u300C\u3042\u3001<wait=0.3>\u5371\u306D\u3047\u2026<wait=0.5> \u6B7B\u306C\u304B\u3068\u601D\u3063\u305F\u2026\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_surprised
    _text: "\u300C\u306A\u3093\u306A\u3093\u3060\u3088\u3001<wait=0.3>\u3042\u306E\u767D\u3044\u30D0\u30B1\u30E2\u30CE\u2026\uFF01\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_anger
    _text: "\u300C\u9854\u898B\u305F\u77AC\u9593\u3001<wait=0.3>\u3081\u3061\u3083\u304F\u3061\u3083\u30D6\u30C1\u5207\u308C\u3066\u7A81\u3063\u8FBC\u3093\u3067\u304D\u305F\u3058\u3083\u306D\u30FC\u304B\uFF01\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_confused
    _text: "\u300C\u2026\u2026\u53C2\u3063\u305F\u306A\u3002<wait=0.3>\u3053\u306E\u90E8\u5C4B\u306F\u3082\u3046\u3042\u3089\u304B\u305F\u8ABF\u3079\u305F\u3057\u2026\u2026\u3002\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_normal
    _text: "\u300C\u51FA\u53E3\u306F\u2026\u2026<wait=0.5>\u3042\u3044\u3064\u304C\u3046\u308D\u3064\u3044\u3066\u308B\u5ECA\u4E0B\u306E\u5148\u3001\u304B\u2026\u2026\u3002\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_confused
    _text: "\u300C\u3069\u3046\u3042\u3063\u3066\u3082\u3042\u306E\u30D0\u30B1\u30E2\u30CE\u3092\u306A\u3093\u3068\u304B\u3057\u306A\u304D\u3083\u3044\u3051\u306D\u3047\u3063\u3066\u3053\u3068\u304B\u2026\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_normal
    _text: "\u300C\u3051\u3069\u3001\u7D20\u624B\u3058\u3083\u3055\u3059\u304C\u306B\u30AD\u30C4\u3044\u3088\u306A\u2026\u2026\u3002<wait=0.4>\n\u306A\u3093\u304B\u6B66\u5668\u306B\u306A\u308A\u305D\u3046\u306A\u3082\u3093\u306F\u2026\u2026\u3002\u300D"
