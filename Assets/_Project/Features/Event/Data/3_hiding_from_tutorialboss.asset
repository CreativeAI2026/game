    _text: "\u300C\u2026\u2026\u307E\u3001\u597D\u90FD\u5408\u3060\u3002<wait=0.3>\u3053\u3053\u306B\u96A0\u308C\u3066\u3066\u3082\u3001\u30B8\u30EA\u8CA7\u3060\u3057\u306A\u2026\u2026\u3002\u300D"
