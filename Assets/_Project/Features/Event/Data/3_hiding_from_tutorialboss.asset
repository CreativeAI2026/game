    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: 
    _text: "\u30A2\u30AA\u30A4\u306F\u5263\u3092\u624B\u306B\u53D6\u308A\u3001<wait=0.3>\u7121\u610F\u8B58\u306E\u3046\u3061\u306B\u69CB\u3048\u3092\u53D6\u308B\u3002"
