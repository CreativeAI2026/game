    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_surprised
    _text: "\u300C\u2026\u2026\u3093\uFF1F<wait=0.3>\u304A\u3063\u3001\u306A\u3093\u3060\u3053\u308C\u3002\u300D"
