  - _kind: 0
    _speaker: 
    _portrait: hero_normal
    _text: "\u300C\u307E\u3041\u3067\u3082\u3001<wait=0.3>\u3053\u308C\u306A\u3089\u6B66\u5668\u3068\u3057\u3066\u4F7F\u3048\u305D\u3046\u3060\u306A\u3002\u300D"
