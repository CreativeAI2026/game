  - _kind: 0
    _speaker: 
    _portrait: hero_question
    _text: "\u300C\u4FFA\u3001\u306A\u3093\u304B\u30B9\u30DD\u30FC\u30C4\u3067\u3082\u3084\u3063\u3066\u305F\u306E\u304B\u2026\u2026\uFF1F\u300D"
