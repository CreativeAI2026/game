  - _kind: 0
    _speaker: 
    _portrait: hero_surprised
    _text: "\u300C\u2026\u2026\u304A\uFF1F<wait=0.3>\u610F\u5916\u3068\u3057\u3063\u304F\u308A\u304F\u308B\u306A\u3002\u300D"
