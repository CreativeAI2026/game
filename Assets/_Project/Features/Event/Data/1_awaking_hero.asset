  - _kind: 0
    _speaker: "\uFF1F\uFF1F\uFF1F"
    _portrait: hero_normal
    _text: "\u300C\u2026\u3042\u308C\u3002 <wait=0.5>\u4FFA\u3001<wait=0.2>\u306A\u3093\u3067\u3053\u3093\u306A\u5E8A\u3067\u2026\u2026\uFF1F\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: 
    _text: "\u75DB\u3080\u982D\u3092\u62BC\u3055\u3048\u306A\u304C\u3089\u3001<wait=0.2>\u3086\u3063\u304F\u308A\u3068\u4E0A\u4F53\u3092\u8D77\u3053\u3059\u3002"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: 
    _text: "\u5468\u56F2\u3092\u898B\u6E21\u3059\u304C\u3001<wait=0.2>\u305D\u3053\u306F\u898B\u899A\u3048\u306E\u306A\u3044\u6BBA\u98A8\u666F\u306A\u90E8\u5C4B\u3060\u3063\u305F\u3002"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: 
    _text: "\u58C1\u969B\u306B\u306F\u7528\u9014\u306E\u5206\u304B\u3089\u306A\u3044\u7269\u54C1\u304C\u4E26\u3073\u3001<wait=0.2>\n\u5E8A\u306B\u306F\u5272\u308C\u305F\u30AC\u30E9\u30B9\u3084\u66F8\u985E\u304C\u7121\u9020\u4F5C\u306B\u6563\u4E71\u3057\u3066\u3044\u308B\u3002"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: "\uFF1F\uFF1F\uFF1F"
    _portrait: hero_normal
    _text: "\u300C\u306A\u3093\u3060\u3053\u3053\u3001<wait=0.2>\u5009\u5EAB\u2026\uFF1F<wait=0.5>
      \u3044\u3084\u3001<wait=0.2>\u306A\u3093\u304B\u306E\u7814\u7A76\u65BD\u8A2D\u3063\u3066\u611F\u3058\u304B\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: "\uFF1F\uFF1F\uFF1F"
    _portrait: hero_normal
    _text: "\u300C\u3053\u3053\u306B\u6765\u308B\u524D\u3001<wait=0.2>\u4F55\u3057\u3066\u305F\u3063\u3051\u2026\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: "\uFF1F\uFF1F\uFF1F"
    _portrait: hero_normal
    _text: "\u300C\u2026\u2026\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: "\uFF1F\uFF1F\uFF1F"
    _portrait: hero_normal
    _text: "\u300C\u2026\u3042\u308C\u3001<wait=0.2> \u30DE\u30B8\uFF1F <wait=0.5>
      \u306A\u3093\u3082\u601D\u3044\u51FA\u305B\u306D\u30FC\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: 
    _text: "\u5E8A\u306B\u843D\u3061\u305F\u30AC\u30E9\u30B9\u7247\u3092\u62FE\u3044\u3001<wait=0.3>\u6620\u308A\u8FBC\u3093\u3060\u81EA\u5206\u306E\u59FF\u3092\u78BA\u304B\u3081\u308B\u3002"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 5
    _speaker: 
    _portrait: 
    _text: 
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: portrait.left.reveal
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: 
    _text: "\u898B\u6163\u308C\u305F\u30B9\u30BF\u30B8\u30E3\u30F3\u306B\u3001<wait=0.2>\u3086\u308B\u3044\u30D1\u30F3\u30C4\u3001<wait=0.5>\u5C65\u304D\u53E4\u3057\u305F\u30B9\u30CB\u30FC\u30AB\u30FC\u3002"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: 
    _text: "\u30DD\u30B1\u30C3\u30C8\u3092\u7AEF\u304B\u3089\u6F01\u3063\u3066\u307F\u308B\u304C\u3001<wait=0.2>\u30B9\u30DE\u30DB\u3082\u8CA1\u5E03\u3082\u3001<wait=0.2>\n\u8EAB\u5206\u3092\u793A\u3059\u3088\u3046\u306A\u3082\u306E\u306F\u4F55\u4E00\u3064\u5165\u3063\u3066\u3044\u306A\u304B\u3063\u305F\u3002"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: "\uFF1F\uFF1F\uFF1F"
    _portrait: hero_question
    _text: "\u300C\u540D\u524D\u306F\u2026<wait=1.0>\u30A2\u30AA\u30A4\u3002\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_question
    _text: "\u300C\u3046\u3093\u3001\u305D\u3053\u306F\u5206\u304B\u308B\u3002<wait=0.5>
      \u305D\u3063\u304B\u3089\u5148\u304C\u3059\u3063\u307D\u308A\u629C\u3051\u3066\u3084\u304C\u308B\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_confused
    _text: "\u300C\u8A18\u61B6\u55AA\u5931\u3063\u3066\u3084\u3064\u304B\u3088\u2026<wait=0.5>
      \u3044\u3084\u3044\u3084\u3001<wait=0.2>\u7B11\u3048\u306D\u3047\u3063\u3066\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_confused
    _text: "\u300C\u307E\u3001<wait=0.2>\u3053\u3053\u3067\u982D\u62B1\u3048\u3066\u5538\u3063\u3066\u3066\u3082\u3057\u3083\u30FC\u306A\u3044\u304B\u3002\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_question
    _text: "\u300C\u8AB0\u304B\u4EBA\u304C\u3044\u308A\u3083\u3001<wait=0.2>\u3053\u3053\u304C\u3069\u3053\u306A\u306E\u304B\u304F\u3089\u3044\u6559\u3048\u3066\u304F\u308C\u308B\u3060\u308D\u3002\u300D"
    _flagKey: 
