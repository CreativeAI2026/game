    _portrait: robot_normal
    _text: "\u300C\u4E0D\u5E78\u4E2D\u306E\u5E78\u3044\u3001\u3068\u8A00\u3063\u305F\u3068\u3053\u308D\u3067\u3059\u306D\u3002\u300D"
