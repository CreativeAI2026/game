  - _kind: 0
    _speaker: 
    _portrait: hero_smile
    _text: "\u300C\u304A\u3063\u3001\u30DE\u30B8\u3067\u958B\u3044\u305F\uFF01 \u3042\u306E\u767D\u3044\u306E\u3001\u3044\u3044\u3082\u3093\u843D\u3068\u3057\u3066\u3044\u3063\u305F\u3058\u3083\u306D\u30FC\u304B\u3002\u300D"
