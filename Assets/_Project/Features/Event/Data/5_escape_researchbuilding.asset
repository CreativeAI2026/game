    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
    _cases: []
    _thenTarget: 0
    _elseTarget: 0
    _joinTarget: 0
  - _kind: 0
    _speaker: 
    _portrait: robot_normal
    _text: "\u300C\u30AB\u30FC\u30C9\u30AD\u30FC\u306E\u8A8D\u8A3C\u3092\u78BA\u8A8D\u3002
      \u30BB\u30AD\u30E5\u30EA\u30C6\u30A3\u30EC\u30D9\u30EB\u30FB\u4E00\u822C\u8B66\u5099\u6A29\u9650\u3067\u306E\u89E3\u9320\u3092\u627F\u8A8D\u3002
      \u6249\u304C\u958B\u304D\u307E\u3059\u3002\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
