    _arg: 
    _cases: []
    _thenTarget: 0
    _elseTarget: 0
    _joinTarget: 0
  - _kind: 0
    _speaker: 
    _portrait: 
    _text: "\u300E\u30D4\u30D4\u30C3\u2026\u2026\u300F\u3068\u3044\u3046\u96FB\u5B50\u97F3\u3068\u5171\u306B\u3001\u30EA\u30FC\u30C0\u30FC\u306E\u30E9\u30F3\u30D7\u304C\u8D64\u304B\u3089\u7DD1\u3078\u3068\u5207\u308A\u66FF\u308F\u308A\u3001\u91CD\u3005\u3057\u3044\u99C6\u52D5\u97F3\u3092\u7ACB\u3066\u3066\u6249\u306E\u30ED\u30C3\u30AF\u304C\u89E3\u9664\u3055\u308C\u305F\u3002"
