  - _kind: 0
    _speaker: 
    _portrait: hero_normal
    _text: "\u300C\u3088\u3057\u3001\u3053\u306E\u6249\u3060\u306A\u3002 \u3048\u30FC\u3063\u3068\u3001\u3055\u3063\u304D\u306E\u30AB\u30FC\u30C9\u30AD\u30FC\u3092\u3053\u3053\u306B\u304B\u3056\u305B\u3070\u3044\u3044\u306E\u304B\u3002\u300D"
