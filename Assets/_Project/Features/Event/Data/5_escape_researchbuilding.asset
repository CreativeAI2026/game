  - _kind: 0
    _speaker: 
    _portrait: hero_confused
    _text: "\u300C\u3046\u308F\u3001\u6539\u3081\u3066\u898B\u308B\u3068\u8840\u304C\u2026
      \u3061\u3083\u3093\u3068\u53CD\u5FDC\u3057\u3066\u304F\u308C\u3088\u2026\uFF1F\u300D"
