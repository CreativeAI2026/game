    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: robot_normal
    _text: "\u300C\u8A18\u61B6\u55AA\u5931\u306E\u7533\u544A\u3092\u78BA\u8A8D\u3002<wait=0.3>
      \u30C7\u30FC\u30BF\u30D9\u30FC\u30B9\u3092\u691C\u7D22\u3057\u307E\u3059\u3002\u300D"
