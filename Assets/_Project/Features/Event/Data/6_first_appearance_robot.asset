    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_question
    _text: "\u300C\u3053\u3053\u306F\u4E00\u4F53\u3069\u3053\u3067\u3001<wait=0.3>\u4F55\u304C\u8D77\u304D\u3066\u3093\u3060\u3088\uFF1F\u300D"
