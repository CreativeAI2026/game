  - _kind: 0
    _speaker: 
    _portrait: robot_normal
    _text: "\u300C\u2015\u2015\u30D4\u30D4\u30C3\u3002<wait=0.3>\u8B66\u544A\u3002
      \u6A5F\u5BC6\u9818\u57DF\u3078\u306E\u30A2\u30AF\u30BB\u30B9\u304C\u906E\u65AD\u3055\u308C\u307E\u3057\u305F\u3002\u300D"
