    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_normal
    _text: "\u300C\u3064\u30FC\u304B\u3001\u30B5\u30DD\u30FC\u30C8\u7528\u30C9\u30ED\u30FC\u30F3\u306A\u3093\u3060\u308D\uFF1F<wait=0.3>
