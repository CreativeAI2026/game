  - _kind: 0
    _speaker: 
    _portrait: robot_normal
    _text: "\u300C\u5BFE\u8A71\u7528\u30D1\u30FC\u30BD\u30CA\u30EA\u30C6\u30A3\u306E\u8D77\u52D5\u306B\u5931\u6557\u3002
      <wait=0.3>\u521D\u671F\u898F\u5B9A\u30E2\u30FC\u30C9\u3078\u79FB\u884C\u3057\u307E\u3059\u3002\u300D"
