    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: robot_normal
    _text: "\u300C\u5F53\u6A5F\u306F\u975E\u6B66\u88C5\u306E\u30B5\u30DD\u30FC\u30C8\u7528AI\u30C9\u30ED\u30FC\u30F3\u3067\u3059\u3002\u300D"
