    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_confused
    _text: "\u300C\u4FFA\u3001\u3053\u3053\u3067\u76EE\u304C\u899A\u3081\u305F\u3070\u3063\u304B\u3067\u3055\u2026\u2026\u3002<wait=0.3>
