    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: robot_normal
    _text: "\u300C\u2026\u2026\u3057\u304B\u3057\u3001\u5F53\u6A5F\u306E\u8A18\u9332\u9818\u57DF\u306B\u3082\u53B3\u91CD\u306A\u30A2\u30AF\u30BB\u30B9\u5236\u9650\u304C\u5B58\u5728\u3057\u307E\u3059\u3002\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: robot_normal
    _text: "\u300C\u73FE\u5728\u958B\u793A\u53EF\u80FD\u306A\u60C5\u5831\u306F\u3001<wait=0.3>\u3053\u3053\u304C\u7279\u6B8A\u306A\u7814\u7A76\u65BD\u8A2D\u3067\u3042\u308B\u3053\u3068\u3002\u300D"
