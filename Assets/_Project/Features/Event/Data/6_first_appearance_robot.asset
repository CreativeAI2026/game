    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_question
    _text: "\u300C\u306A\u3093\u3060\u3088\u3001\u6025\u306B\u305D\u306E\u5805\u82E6\u3057\u3044\u558B\u308A\u65B9\u2026\u2026\u3002\u300D"
