    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_question
    _text: "\u300C\u2026\u2026\u30B5\u30DD\u30FC\u30C8\u7528\uFF1F<wait=0.3> \u304A\u3044\u3001\u3061\u3087\u3063\u3068\u5F85\u3066\u2014\u2014\u300D"
