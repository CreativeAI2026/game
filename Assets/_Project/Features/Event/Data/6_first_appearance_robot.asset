    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_confused
    _text: "\u300C\u3044\u3084\u3001\u3060\u304B\u3089\u8A71\u3092\u2014\u2014\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: robot_normal
    _text: "\u300C\u7565\u79F0\u3001HRBT Drone\u3002<wait=0.3> \u305F\u3060\u3057\u3001\u6B63\u5F0F\u540D\u79F0\u306E\u547C\u79F0\u306F\u975E\u52B9\u7387\u3067\u3059\u3002\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_anger
    _text: "\u300C\u304A\u3044\uFF01<wait=0.3> \u4EBA\u306E\u8A71\u805E\u3044\u3066\u3093\u306E\u304B\uFF01\uFF1F\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: robot_normal
    _text: "\u300C\u5E73\u5747\u7684\u306A\u4EBA\u9593\u306E\u8A18\u61B6\u5BB9\u91CF\u3092\u8003\u616E\u3057\u3001<wait=0.3>\u300C\u30CF\u30EA\u30DC\u30C6\u300D\u3068\u3044\u3046\u547C\u79F0\u3092\u63A8\u5968\u3057\u307E\u3059\u3002\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_anger
    _text: "\u300C\u805E\u3051\u3088\uFF01\uFF01<wait=0.3> \u3057\u304B\u3082\u3055\u308A\u3052\u306A\u304F\u30D0\u30AB\u306B\u3057\u3066\u3093\u3060\u308D\uFF01\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_confused
    _text: "\u300C\u3063\u305F\u304F\u2026\u2026<wait=0.3> \u5999\u306B\u8179\u7ACB\u3064\u30ED\u30DC\u3060\u306A\u2026\u2026\u3002\u300D"
    _flagKey: 
    _options: []
    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_smile
    _text: "\u300C\u307E\u3001\u3044\u3044\u3084\u3002<wait=0.3> \u9060\u616E\u306A\u304F\u30CF\u30EA\u30DC\u30C6\u3063\u3066\u547C\u3093\u3067\u3084\u308B\u3088\u3002\u300D"
