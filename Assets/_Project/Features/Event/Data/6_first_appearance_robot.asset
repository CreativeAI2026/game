    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: robot_normal
    _text: "\u300C\u6B63\u5F0F\u540D\u79F0\u306F\u3001Hazardous Research & Bio-Technology
      Drone\u3002\u300D"
    _flagKey: 
    _options: []
