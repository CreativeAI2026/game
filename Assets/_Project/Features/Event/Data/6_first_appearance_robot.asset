    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: hero_confused
    _text: "\u300C\u2026\u2026\u3093\uFF1F<wait=0.3> \u4ECA\u3001\u4E00\u77AC\u666E\u901A\u306B\u558B\u3093\u306A\u304B\u3063\u305F\u304B\uFF1F\u300D"
