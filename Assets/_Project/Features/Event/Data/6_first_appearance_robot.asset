    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: robot_normal
    _text: "\u300C\u305D\u3057\u3066\u3001\u65BD\u8A2D\u5185\u3067\u7570\u5E38\u4E8B\u614B\u304C\u767A\u751F\u3057\u3066\u3044\u308B\u3053\u3068\u306E\u307F\u3067\u3059\u3002\u300D"
