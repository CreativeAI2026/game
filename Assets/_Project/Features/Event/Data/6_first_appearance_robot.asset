    _portrait: robot_normal
    _text: "\u300C\u7279\u5B9A\u6761\u4EF6\u304C\u6E80\u305F\u3055\u308C\u308B\u307E\u3067\u3001<wait=0.3>\u305D\u306E\u4ED6\u306E\u60C5\u5831\u306F\u958B\u793A\u3067\u304D\u307E\u305B\u3093\u3002\u300D"
