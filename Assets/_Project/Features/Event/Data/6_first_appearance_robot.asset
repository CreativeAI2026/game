    _itemKey: 
    _weaponKey: 
    _message: 
    _command: 
    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: robot_normal
    _text: "\u300C\u8B66\u6212\u306E\u89E3\u9664\u3092\u63A8\u5968\u3057\u307E\u3059\u3002<wait=0.3>
      \u6B66\u5668\u3092\u4E0B\u308D\u3057\u3066\u304F\u3060\u3055\u3044\u3002\u300D"
