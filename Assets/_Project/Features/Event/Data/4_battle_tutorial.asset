    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: 
    _text: "\u602A\u7269\u306F\u7A81\u7136\u8EAB\u3092\u7FFB\u3057\u3001<wait=0.3>\u5ECA\u4E0B\u306E\u5965\u3078\u9003\u3052\u53BB\u3063\u305F\u3002"
