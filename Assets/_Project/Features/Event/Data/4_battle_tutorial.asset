  - _kind: 0
    _speaker: 
    _portrait: 
    _text: "\u300C\u30AE\u2026\u2026\u30A3\u30A3\u3001\u30A1\u30A1\u30A2\u30A2\u30C3\u2026\u2026\uFF01\u300D"
