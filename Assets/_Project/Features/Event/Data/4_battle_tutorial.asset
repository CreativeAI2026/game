  - _kind: 0
    _speaker: 
    _portrait: hero_surprised
    _text: "\u300C\u2026\u2026\u3042\u3063\u3001\u304A\u3044\uFF01<wait=0.3>\u9003\u3052\u3093\u306E\u304B\u3088\uFF01\u300D"
