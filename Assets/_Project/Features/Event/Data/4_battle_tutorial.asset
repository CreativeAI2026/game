  - _kind: 0
    _speaker: 
    _portrait: hero_anger
    _text: "\u300C\u307E\u3060\u52D5\u304F\u304B\u3088\u2026\u2026\uFF01<wait=0.4>\u6B21\u3067\u30C8\u30C9\u30E1\u3092\u2014\u2014\u300D"
