    _portrait: hero_anger
    _text: "\u300C\u304F\u3063\u2026\u2026\uFF01<wait=0.3>\u75DB\u3063\u3066\u3047\u306A\u3001\u3053\u306E\u91CE\u90CE\u2026\u2026\uFF01\u300D"
