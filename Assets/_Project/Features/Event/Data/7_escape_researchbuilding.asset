    _text: "\u300C\u3088\u3057\u3001\u3053\u306E\u6249\u3060\u306A\u3002<wait=0.3>
      \u3048\u30FC\u3063\u3068\u3001\u30AB\u30FC\u30C9\u30AD\u30FC\u3092\u3053\u3053\u306B\u2026\u2026\u3002\u300D"
