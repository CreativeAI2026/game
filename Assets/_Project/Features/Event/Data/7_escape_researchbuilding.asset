    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: robot_normal
    _text: "\u300C\u30ED\u30C3\u30AF\u89E3\u9664\u5B8C\u4E86\u3002<wait=0.3> \u6249\u3092\u958B\u653E\u3057\u307E\u3059\u3002\u300D"
    _flagKey: 
