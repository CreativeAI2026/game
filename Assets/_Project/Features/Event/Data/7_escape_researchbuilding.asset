  - _kind: 0
    _speaker: 
    _portrait: hero_surprised
    _text: "\u300C\u304A\u3063\u3001\u30DE\u30B8\u3067\u958B\u3044\u305F\uFF01\u300D"
    _flagKey: 
    _options: []
