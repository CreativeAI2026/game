  - _kind: 0
    _speaker: 
    _portrait: hero_smile
    _text: "\u300C\u3042\u306E\u767D\u3044\u306E\u3001<wait=0.3>\u3044\u3044\u3082\u3093\u843D\u3068\u3057\u3066\u3063\u305F\u3058\u3083\u306D\u30FC\u304B\u3002\u300D"
