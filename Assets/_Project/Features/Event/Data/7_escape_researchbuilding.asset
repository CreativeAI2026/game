    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: 
    _text: "\u30D4\u30D4\u30C3\u2026\u2026<wait=0.5> \u96FB\u5B50\u97F3\u3068\u5171\u306B\u3001\u30E9\u30F3\u30D7\u304C\u8D64\u304B\u3089\u7DD1\u3078\u5909\u308F\u308B\u3002"
