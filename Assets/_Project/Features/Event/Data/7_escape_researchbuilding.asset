    _arg: 
  - _kind: 0
    _speaker: 
    _portrait: robot_normal
    _text: "\u300C\u30AB\u30FC\u30C9\u30AD\u30FC\u306E\u8A8D\u8A3C\u3092\u78BA\u8A8D\u3002<wait=0.3>
      \u4E00\u822C\u8B66\u5099\u6A29\u9650\u3067\u306E\u89E3\u9320\u3092\u627F\u8A8D\u3002\u300D"
