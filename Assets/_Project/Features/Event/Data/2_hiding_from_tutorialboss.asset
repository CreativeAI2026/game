    _text: "\u300C\u53C2\u3063\u305F\u306A\u2026 \u3042\u3093\u306A\u3093\u306B\u3046\u308D\u3064\u304B\u308C\u3066\u305F\u3089\u51FA\u53E3\u3082\u63A2\u3059\u306B\u63A2\u305B\u306A\u3044\u3002\u300D"
